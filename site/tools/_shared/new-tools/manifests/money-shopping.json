  "tools": [
    {
      "slug": "price-per-use-planner",
      "title": "Price-Per-Use Planner",
      "description": "Estimate the effective cost of an item from its purchase price, expected uses, and remaining resale value.",
      "limitations": "This is a simple estimate, not a prediction of durability or resale demand; enter realistic use and resale assumptions.",
      "fields": [
        {
          "id": "itemName",
          "label": "Item name",
          "type": "text",
          "required": true,
          "placeholder": "Reusable water bottle"
        },
        {
          "id": "purchasePrice",
          "label": "Purchase price",
          "type": "number",
          "required": true,
          "min": 0,
          "max": 100000,
          "step": "any",
          "default": 80
        },
        {
          "id": "expectedUses",
          "label": "Expected uses",
          "type": "number",
          "required": true,
          "min": 1,
          "max": 100000,
          "step": 1,
          "default": 200
        },
        {
          "id": "resaleValue",
          "label": "Expected resale value",
          "type": "number",
          "required": false,
          "min": 0,
          "max": 100000,
          "step": "any",
          "default": 10
        },
        {
          "id": "currency",
          "label": "Currency symbol",
          "type": "text",
          "required": false,
          "default": "$"
        }
      ],
      "testValues": {
        "itemName": "Reusable bottle",
        "purchasePrice": 80,
        "expectedUses": 200,
        "resaleValue": 10,
        "currency": "$"
      }
    },
