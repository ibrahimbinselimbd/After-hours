{
  "category": {
    "id": "events-community",
    "title": "Events & Community",
    "description": "Private, browser-local tools for planning inclusive events, community participation, communications, and follow-up.",
    "accent_color": "#7C3AED"
  },
  "tools": [
    {
      "slug": "event-format-fit-score",
      "title": "Event Format Fit Score",
      "description": "Compare how well a proposed event format fits the audience, interaction goal, and available time.",
      "limitations": "A planning heuristic, not a guarantee of attendance or engagement.",
      "fields": [
        {
          "id": "audienceSize",
          "label": "Expected attendees",
          "type": "number",
          "required": true,
          "min": 1,
          "max": 10000,
          "step": 1,
          "default": 40
        },
        {
          "id": "interactionLevel",
          "label": "Desired interaction",
          "type": "select",
          "required": true,
          "options": [
            "low",
            "medium",
            "high"
          ],
          "default": "medium"
        },
        {
          "id": "minutes",
          "label": "Available minutes",
          "type": "number",
          "required": true,
          "min": 15,
          "max": 1440,
          "step": 5,
          "default": 90
        },
        {
          "id": "format",
          "label": "Proposed format",
          "type": "select",
          "required": true,
          "options": [
            "talk",
            "workshop",
            "roundtable",
            "open-house"
          ],
          "default": "workshop"
        }
      ],
      "testValues": {
        "audienceSize": "40",
        "interactionLevel": "medium",
        "minutes": "90",
        "format": "workshop"
      }
    },
    {
      "slug": "rsvp-deadline-planner",
      "title": "RSVP Deadline Planner",
      "description": "Set a practical RSVP deadline from preparation lead time, reminder spacing, and expected response lag.",
      "limitations": "Assumes attendees respond manually; it cannot predict actual response behavior.",
      "fields": [
        {
          "id": "eventDate",
          "label": "Event date",
          "type": "date",
          "required": true,
          "default": "2026-12-12"
        },
        {
          "id": "prepDays",
          "label": "Preparation days after RSVP close",
          "type": "number",
          "required": true,
          "min": 0,
          "max": 90,
          "step": 1,
          "default": 7
        },
        {
          "id": "reminderDays",
          "label": "Reminder spacing",
          "type": "number",
          "required": true,
          "min": 1,
          "max": 30,
          "step": 1,
          "default": 4
        },
        {
          "id": "responseLag",
          "label": "Expected response lag",
          "type": "number",
          "required": true,
          "min": 0,
          "max": 30,
          "step": 1,
          "default": 2
        }
      ],
      "testValues": {
        "eventDate": "2026-12-12",
        "prepDays": "7",
        "reminderDays": "4",
        "responseLag": "2"
      }
    },
    {
      "slug": "capacity-buffer-planner",
      "title": "Attendance Capacity Buffer Planner",
      "description": "Estimate a sensible invite cap from room capacity and a manually supplied no-show estimate.",
      "limitations": "No-show rates are assumptions; verify fire, venue, and accessibility limits separately.",
      "fields": [
        {
          "id": "roomCapacity",
          "label": "Usable room capacity",
          "type": "number",
          "required": true,
          "min": 1,
          "max": 100000,
          "step": 1,
          "default": 80
        },
        {
          "id": "noShowPercent",
          "label": "Expected no-show percent",
          "type": "number",
          "required": true,
          "min": 0,
          "max": 95,
          "step": 1,
          "default": 15
        },
        {
          "id": "reservedSeats",
          "label": "Seats reserved for access or hosts",
          "type": "number",
          "required": true,
          "min": 0,
          "max": 100000,
          "step": 1,
          "default": 6
        }
      ],
      "testValues": {
        "roomCapacity": "80",
        "noShowPercent": "15",
        "reservedSeats": "6"
      }
    },
    {
      "slug": "accessibility-priority-planner",
      "title": "Accessibility Priority Planner",
      "description": "Rank accessibility actions by likely reach, effort, and consequence if omitted.",
      "limitations": "It is a prioritization aid, not an accessibility compliance assessment.",
      "fields": [
        {
          "id": "actions",
