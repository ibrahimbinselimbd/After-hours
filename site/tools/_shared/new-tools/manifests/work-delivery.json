{
  "category": {
    "id": "work-delivery",
    "title": "Work & Project Delivery",
    "description": "Browser-local tools for planning, prioritizing, coordinating, validating, and closing project work without network access.",
    "accent_color": "#2563EB"
  },
  "tools": [
    {
      "slug": "delivery-risk-register",
      "title": "Delivery Risk Register",
      "description": "Ranks a delivery risk from likelihood and impact and proposes a response priority.",
      "limitations": "Scores are subjective and do not predict outcomes.",
      "fields": [
        {
          "id": "riskName",
          "label": "Risk name",
          "type": "text",
          "required": true,
          "placeholder": "Vendor API change"
        },
        {
          "id": "likelihood",
          "label": "Likelihood (1\u20135)",
          "type": "number",
          "required": true,
          "min": 1,
          "max": 5,
          "step": 1
        },
        {
          "id": "impact",
          "label": "Impact (1\u20135)",
          "type": "number",
          "required": true,
          "min": 1,
          "max": 5,
          "step": 1
        },
        {
          "id": "mitigation",
          "label": "Mitigation or trigger",
          "type": "textarea",
          "required": true,
          "placeholder": "Pin version and test weekly"
        }
      ],
      "testValues": {
        "riskName": "Vendor API change",
        "likelihood": 4,
        "impact": 5,
        "mitigation": "Pin version and test weekly"
      }
    },
    {
      "slug": "project-charter-builder",
      "title": "Project Charter Builder",
      "description": "Turns a goal, success measure, boundaries, and sponsor context into a compact alignment charter.",
      "limitations": "It cannot validate stakeholder agreement or feasibility.",
      "fields": [
        {
          "id": "goal",
          "label": "Outcome goal",
          "type": "textarea",
          "required": true,
          "placeholder": "What should change?"
        },
        {
          "id": "successMeasure",
          "label": "Success measure",
          "type": "text",
          "required": true,
          "placeholder": "Metric and target"
        },
        {
          "id": "inScope",
          "label": "In scope",
          "type": "textarea",
          "required": true,
          "placeholder": "Included work"
        },
        {
          "id": "outOfScope",
          "label": "Out of scope",
          "type": "textarea",
          "required": true,
          "placeholder": "Explicit exclusions"
        }
      ],
      "testValues": {
        "goal": "Launch a self-service support portal",
        "successMeasure": "80% of requests resolved without escalation",
        "inScope": "FAQ, search, feedback form",
        "outOfScope": "Native mobile app"
      }
    },
    {
      "slug": "milestone-map-builder",
