# Copy to .env on a private inference host; never commit real secrets.
PORT=8080
TEXT_DETECTOR_MODEL=openai-community/roberta-base-openai-detector
TEXT_DETECTOR_API_KEY=replace-with-a-long-random-secret
TEXT_DETECTOR_MAX_WORDS=8000
TEXT_DETECTOR_MAX_CHARS=50000
TEXT_DETECTOR_SEGMENT_WORDS=180
TEXT_DETECTOR_MAX_INFERENCE_CONCURRENCY=1
TEXT_DETECTOR_INFERENCE_TIMEOUT_SECONDS=30
# Optional Hugging Face cache; mount this directory persistently in Docker.
HF_HOME=/data/huggingface
TRANSFORMERS_CACHE=/data/huggingface/transformers
