{
  "name": "afterhours-district",
  "account_id": "d7c6fd4ad1a090bcac15dde8a85b178c",
  "main": "worker.js",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/v1/passport-photo/*"
