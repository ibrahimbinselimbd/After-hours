# Site/proxy server. Values are examples, not active configuration.
# Node does not automatically load this file: export values in your host's environment.
HOST=127.0.0.1
PORT=4173
# Leave blank until you have your actual inference origin.
# HTTPS required for remote hosts; HTTP loopback allowed for local development.
TEXT_DETECTOR_API_ORIGIN=
# Set the same freshly generated secret on the proxy and Python host.
# Never put this key in site/, browser JavaScript, logs, or Git.
TEXT_DETECTOR_API_KEY=
